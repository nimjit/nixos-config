editbx              = '', '', '',       h251, h237
editcp              = '', '', standout, h235, h251
popupbg             = '', '', '',       h251, h237
popupper            = '', '', '',       h235, h222
alert               = '', '', bold,     h235, h160
mark                = '', '', bold,     h235, h107
frame               = '', '', '',       h179, default

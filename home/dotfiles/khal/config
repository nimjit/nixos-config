[calendars]

[[personal]]
path = ~/.local/share/calendars/*
type = discover

[sqlite]
path = ~/.local/share/khal/khal.db

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
default_timezone = Europe/Amsterdam
local_timezone = Europe/Amsterdam
firstweekday = 0

[default]
timedelta = 7d
show_week_numbers = True

[palette]
# Ukiyo base16 palette — format: low_fg, low_bg, mono, high_fg, high_bg
# h222=gold(e0ba86) h179=amber(ba945f) h251=text(ccc2b7) h237=dark(413632)
# h235=darkest(372d29) h107=green(9aad6e) h160=red(c72626)
header              = '', '', bold,     h222, default
date header         = '', '', '',       h251, h237
date header focused = '', '', bold,     h235, h222
date header selected = '', '', '',      h251, h235
dayname             = '', '', '',       h179, default
monthname           = '', '', '',       h179, default
weeknumber_right    = '', '', '',       h179, default
today               = '', '', '',       h235, h179
today focus         = '', '', bold,     h235, h222
list                = '', '', '',       h251, default
list focused        = '', '', bold,     h235, h222
edit                = '', '', '',       h251, h237
edit focus          = '', '', bold,     h251, h222
editbx              = '', '', '',       h251, h237
editcp              = '', '', standout, h235, h251
popupbg             = '', '', '',       h251, h237
popupper            = '', '', '',       h235, h222
alert               = '', '', bold,     h235, h160
mark                = '', '', bold,     h235, h107
frame               = '', '', '',       h179, default
frame focus         = '', '', '',       h222, default
caption             = '', '', bold,     h222, default

* {
    bg:      #372d29;
    bg-alt:  #413632;
    sel:     #504431;
    dim:     #868074;
    fg:      #ccc2b7;
    gold:    #e0ba86;
    amber:   #da9517;

    font:             "JetBrainsMono Nerd Font 13";
    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @sel;
    border-radius:    8px;
    width:            460px;
    location:         center;
    anchor:           center;
    y-offset:         -120px;
}

mainbox {
    background-color: transparent;
    spacing:          0px;
    children:         [inputbar, listview];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    8px 8px 0px 0px;
    border:           0px 0px 1px 0px;
    border-color:     @sel;
    padding:          10px 14px;
    children:         [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color:       @gold;
    padding:          0px 8px 0px 0px;
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "search…";
    placeholder-color: @dim;
    cursor-color:      @gold;
}

listview {
    background-color: transparent;
    padding:          4px 0px;
    lines:            7;
    columns:          1;
    scrollbar:        false;
    spacing:          0px;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          8px 14px;
    spacing:          10px;
    children:         [element-icon, element-text];
}

element-icon {
    background-color: transparent;
    size:             28px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @sel;
    text-color:       @gold;
    border-radius:    4px;
}

element normal.urgent,
element selected.urgent {
    text-color: @amber;
}

element selected.urgent {
    background-color: @sel;
}
